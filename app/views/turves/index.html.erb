<h1>All Turves</h1>


<div class="mb-3" style = "display: grid; justify-items: center;align-items: center;">
<table class="table table-striped" >
  <thead>
    <tr>
      <th scope="col">Turf_id</th>
      <th scope="col">Name</th>
      <th scope="col">Location</th>
      <th scope="col">Opening Time</th>
      <th scope="col">Closing Time</th>
      <th scope="col">Owner Name</th>
      <th scope="col">Status</th>
      <th scope="col">View </th>
      <th scope="col">Edit </th>
      <th scope="col">DELETE</th>
    </tr>
  </thead>
  <tbody>
    <% @turves.each do |turf| %>
      <tr>
        <th scope="row"><%= turf.id %></th>
        
        <td><%= turf.name %></td>
        <td><%= turf.location %></td>
        <td><%= turf.opening_time.strftime('%I:%M %p') %></td>
        <td><%= turf.close_time.strftime('%I:%M %p') %></td>
        <td><%= turf.user.name %></td>
        
        <% if turf.status? %>
            <td>Open</td>
        <% else %>
            <td>Close</td>
        <% end %>

         <td><%= link_to  turf_path(turf.id), class: 'btn btn-light' do %>view <% end %> </td>
        <td> <%= link_to edit_turf_path(turf.id), class: 'btn btn-primary' do  %>edit  <% end %></td>
        <td> <%= link_to  edit_turf_path(turf.id),method: :delete, class: 'btn btn-danger' do  %>delete<% end %></td>
        
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<%= link_to new_turf_path, class: 'btn btn-info' do %>
    Add New Turf
<% end %>




 