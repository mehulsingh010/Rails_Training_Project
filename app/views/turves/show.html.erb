
<h1 style= "">Single Turf</h1>

<div class="container-xl">
  <div class="row">
    <div class="col"">
    <div id="carouselExampleControlsNoTouching" class=" col carousel slide" data-bs-touch="false" data-bs-interval="false">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="<%= asset_path('turf1.png') %>" class="d-block w-100" alt="...">
      </div>
      <div class="carousel-item">
        <img src="<%= asset_path('turf2.webp') %>" class="d-block w-100" alt="...">
      </div>
      <div class="carousel-item">
        <img src="<%= asset_path('turf3.webp') %>" class="d-block w-100" alt="...">
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>

    </div>
    </div>
    <div class="col">
    <div class="card ">
    
    <div class="card-body">
      <h3 class="card-title"><%= @turf.name %> </h3>

      <i> </i>
      <h6 class="">Location :  <%= @turf.location %> </h6>
      <h6 class="">Open Time :  <%= @turf.opening_time.strftime('%I:%M %p') %> </h6>
      <h6 class="">Close Time:  <%= @turf.close_time.strftime('%I:%M %p') %> </h6>

      <h6 class="<%= @turf.status? ? 'text-success' : 'text-danger' %>">
      Status: <%= @turf.status? ? 'Open' : 'Closed' %>
      </h6>
      <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
      <a href="#" class="btn btn-primary">Go somewhere</a>
    </div>
    
    </div>
  </div>
  
</div>