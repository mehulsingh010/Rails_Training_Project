<h1> Edit Turf Details </h1>

<%= form_with model: @turf, method: :put do |f| %>

    <div class="form-group mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :location, class: "form-label" %>
      <%= f.text_field :location %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :opening_time, class: "form-label" %>
      <%= f.time_field :opening_time %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :close_time, class: "form-label" %>
      <%= f.time_field :close_time %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :status ,class: "form-label"%>
      <%= f.check_box :status, class: "form-check-input" %> 
    </div>

    <div class="form-group mb-3">
      <%= f.label :user_id, "Assign User",class: "form-label" %>
      <%= f.select :user_id, User.all.map { |u| [u.name, u.id] }, { include_blank: "Select a User" }, class: "form-control" %>
    </div>

    <div class="form-group mb-3">
    <%= f.submit "submit",class: "btn btn-success" %> 
    </div>
<% end %>