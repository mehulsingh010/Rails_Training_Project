<h1>Edit User Details </h1>

<div style = "display: grid; justify-items: center;align-items: center;" >
<%= form_with model: @user,method: :put do |user_form| %>
    
      <div class="form-group mb-3">
      <%=user_form.label :name ,class: "form-label"  %>
      <%= user_form.text_field :name %>
      </div>

      <div class="form-group mb-3">
      <%= user_form.label :email,class: "form-label" %>
      <%= user_form.email_field :email%>
      </div>


      <div class="form-group mb-3">
       <%= user_form.label :password ,class: "form-label"%>
       <%= user_form.password_field :password_digest %>
      </div>

      <div class="form-group mb-3">
      <%= user_form.label :phone_number,class: "form-label"%>
      <%= user_form.telephone_field :phone_number %>
      </div>

      <div class="form-group mb-3">
      <%= user_form.label :User_type ,class: "form-label"%>
      <%= user_form.select :role_id, [["user", 1],["owner",2]] %>
      </div>
      <div class="form-group mb-3">
      <%= user_form.submit "submit",class: "btn btn-success" %> 
      <%= link_to  "back" ,users_path ,class: "btn btn-primary" %> 
      </div>
<% end %>

