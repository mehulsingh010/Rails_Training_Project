<h1>All Users</h1>


<div class="mb-3">
<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">User_ID</th>
      <th scope="col">Name</th>
      <th scope="col">Email</th>
      <th scope="col">Phone Number</th>
      <th scope="col">Role ID</th>
      <th scope="col">View </th>
      <th scope="col">Edit </th>
      <th scope="col">DELETE</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <th scope="row"><%= user.id %></th>
        
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.phone_number %></td>
        <td><%= user.role.name.humanize %></td>
        <td><%= link_to  user_path(user.id), class: 'btn btn-light' do %>view <% end %> </td>
        <td> <%= link_to edit_user_path(user.id), class: 'btn btn-primary' do  %>edit  <% end %></td>
        <td> <%= link_to  user_path(user.id),method: :delete, class: 'btn btn-danger' do  %>delete<% end %></td>
        
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<%= link_to new_user_path, class: 'btn btn-info' do %>
  Add New User
<% end %>


<%= link_to turves_path, class: 'btn btn-info' do %>
  View ALL Turf
<% end %>

 