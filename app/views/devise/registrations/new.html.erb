

<!-- Sign Up Section -->
<section class="bg-light py-3 py-md-5">
<h1>Admin Can Create An Account </h1>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
        <div class="card border border-light-subtle rounded-3 shadow-sm">
          <div class="card-body p-3 p-md-4 p-xl-5">

            <!-- Title -->
            <h2 class="fs-6 fw-normal text-center text-secondary mb-4">Create an Account</h2>

            <!-- Error Messages -->
            <%= render "devise/shared/error_messages", resource: resource %>

            <!-- Devise Registration Form -->
            <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
              <div class="row gy-2 overflow-hidden">

                <!-- Email Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.email_field :email, class: "form-control", placeholder: "name@example.com", autofocus: true, autocomplete: "email", required: true %>
                    <%= f.label :email, "Email", class: "form-label" %>
                  </div>
                </div>

                <!-- Password Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.password_field :password, class: "form-control", placeholder: "Password", autocomplete: "new-password", required: true %>
                    <%= f.label :password, "Password", class: "form-label" %>
                    <% if @minimum_password_length %>
                      <small class="text-muted">(<%= @minimum_password_length %> characters minimum)</small>
                    <% end %>
                  </div>
                </div>

                <!-- Password Confirmation Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm Password", autocomplete: "new-password", required: true %>
                    <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
                  </div>
                </div>

                <!-- Name Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.text_field :name, class: "form-control", placeholder: "Full Name", autocomplete: "name", required: true %>
                    <%= f.label :name, "Full Name", class: "form-label" %>
                  </div>
                </div>

                <!-- Phone Number Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.telephone_field :phone_number, class: "form-control", placeholder: "Phone Number", autocomplete: "tel", required: true %>
                    <%= f.label :phone_number, "Phone Number", class: "form-label" %>
                  </div>
                </div>

                <!-- Role Selection -->
                <div class="col-12">
                  <div class="form-group mb-3">
                    <%= f.label :role_id, "User Type", class: "form-label" %>
                    <%= f.select :role_id, [["User", 1], ["Owner", 2]], {}, class: "form-select" %>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="col-12">
                  <div class="d-grid my-3">
                    <%= f.submit "Sign up", class: "btn btn-primary btn-lg" %>
                  </div>
                </div>

                <!-- Already Have an Account? -->
                <div class="col-12">
                  <p class="m-0 text-secondary text-center">
                    Already have an account? <%= link_to "Log in", new_session_path(resource_name), class: "link-primary text-decoration-none" %>
                  </p>
                </div>

              </div>
            <% end %>

            <!-- Devise Shared Links -->
            <%= render "devise/shared/links" %>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>


