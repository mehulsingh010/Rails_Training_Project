<!-- Edit Profile Section -->
<section class="bg-light py-3 py-md-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
        <div class="card border border-light-subtle rounded-3 shadow-sm">
          <div class="card-body p-3 p-md-4 p-xl-5">

            <!-- Title -->
            <h2 class="fs-6 fw-normal text-center text-secondary mb-4">Edit <%= resource_name.to_s.humanize %></h2>

            <!-- Error Messages -->
            <%= render "devise/shared/error_messages", resource: resource %>

            <!-- Devise Edit Profile Form -->
            <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
              <div class="row gy-2 overflow-hidden">

                <!-- Email Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.email_field :email, class: "form-control", placeholder: "name@example.com", autofocus: true, autocomplete: "email", required: true %>
                    <%= f.label :email, "Email", class: "form-label" %>
                  </div>
                </div>

                <!-- Email Confirmation Status -->
                <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                  <div class="alert alert-warning text-center">
                    Currently waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong>
                  </div>
                <% end %>

                <!-- Password Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.password_field :password, class: "form-control", placeholder: "New Password", autocomplete: "new-password" %>
                    <%= f.label :password, "New Password (leave blank if you don't want to change it)", class: "form-label" %>
                    <% if @minimum_password_length %>
                      <small class="text-muted">(<%= @minimum_password_length %> characters minimum)</small>
                    <% end %>
                  </div>
                </div>

                <!-- Password Confirmation Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm New Password", autocomplete: "new-password" %>
                    <%= f.label :password_confirmation, "Confirm New Password", class: "form-label" %>
                  </div>
                </div>

                <!-- Current Password Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.password_field :current_password, class: "form-control", placeholder: "Current Password", autocomplete: "current-password", required: true %>
                    <%= f.label :current_password, "Current Password (required to confirm changes)", class: "form-label" %>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="col-12">
                  <div class="d-grid my-3">
                    <%= f.submit "Update", class: "btn btn-primary btn-lg" %>
                  </div>
                </div>

              </div>
            <% end %>

            <!-- Cancel Account Section -->
            <h3 class="text-danger text-center mt-4">Cancel My Account</h3>
            <p class="text-secondary text-center">Unhappy? You can delete your account permanently.</p>
            <div class="text-center">
              <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "btn btn-danger btn-sm" %>
            </div>

            <!-- Back Link -->
            <div class="text-center mt-3">
              <%= link_to "Back", root_path, class: "link-primary text-decoration-none" %>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
