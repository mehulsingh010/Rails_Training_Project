<!-- Forgot Password Section -->
<section class="bg-light py-3 py-md-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
        <div class="card border border-light-subtle rounded-3 shadow-sm">
          <div class="card-body p-3 p-md-4 p-xl-5">

            <!-- Title -->
            <h2 class="fs-6 fw-normal text-center text-secondary mb-4">Forgot your password?</h2>

            <!-- Error Messages -->
            <%= render "devise/shared/error_messages", resource: resource %>

            <!-- Devise Forgot Password Form -->
            <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
              <div class="row gy-2 overflow-hidden">

                <!-- Email Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.email_field :email, class: "form-control", placeholder: "name@example.com", autofocus: true, autocomplete: "email", required: true %>
                    <%= f.label :email, "Email", class: "form-label" %>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="col-12">
                  <div class="d-grid my-3">
                    <%= f.submit "Send me reset password mail", class: "btn btn-primary btn-lg" %>
                  </div>
                </div>

              </div>
            <% end %>
            <div class="col-12">
              <p class="m-0 text-secondary text-center">
                <%= link_to "Log in", new_session_path(resource_name), class: "link-primary text-decoration-none" %>
              </p>
              
            </div>
            <p class="m-0 text-secondary text-center">
            <%= link_to "Sign up", new_registration_path(resource_name), class: "link-primary text-decoration-none" %>
            </p>
            <!-- Devise Shared Links -->
            <%= render "devise/shared/links" %>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
