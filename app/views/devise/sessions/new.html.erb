
<!-- Login Section -->
<section class="bg-light py-3 py-md-5">
  <div class="container">
 

    <div class="row justify-content-center">
   
      <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
      <h2>Admin Log in</h2>
      <div class="card border border-light-subtle rounded-3 shadow-sm">
          <div class="card-body p-3 p-md-4 p-xl-5">
            
            <!-- Logo 
            <div class="text-center mb-3">
              <%= link_to root_path do %>
                <%= image_tag "", alt: "BootstrapBrain Logo", width: 175, height: 57 %>
              <% end %>
            </div>
            -->
            <h2 class="fs-6 fw-normal text-center text-secondary mb-4">Sign in to your account</h2>

            <!-- Devise Login Form -->
            <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
              <div class="row gy-2 overflow-hidden">
                
                <!-- Email Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.email_field :email, class: "form-control", placeholder: "name@example.com", required: true %>
                    <%= f.label :email, "Email", class: "form-label" %>
                  </div>
                </div>

                <!-- Password Field -->
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= f.password_field :password, class: "form-control", placeholder: "Password", required: true %>
                    <%= f.label :password, "Password", class: "form-label" %>
                  </div>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="col-12">
                  <div class="d-flex gap-2 justify-content-between">
                    <div class="form-check">
                      <%= f.check_box :remember_me, class: "form-check-input" %>
                      <%= f.label :remember_me, class: "form-check-label text-secondary" %>
                    </div>
                    <%= link_to "Forgot password?", new_password_path(resource_name), class: "link-primary text-decoration-none" %>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="col-12">
                  <div class="d-grid my-3">
                    <%= f.submit "Log in", class: "btn btn-primary btn-lg" %>
                  </div>
                </div>

                <!-- Sign Up Link -->
                <div class="col-12">
                  <p class="m-0 text-secondary text-center">
                    Don't have an account? <%= link_to "Sign up", new_registration_path(resource_name), class: "link-primary text-decoration-none" %>
                  </p>
                </div>

              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



